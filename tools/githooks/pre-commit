#!/bin/sh
# Pre-commit hook: refresh sitemap.xml <lastmod> for staged page changes.
# The updater only rewrites the file when a date actually changes, so this
# is silent for unrelated commits. Enabled by tools/setup.sh.
set -e
repo=$(git rev-parse --show-toplevel)
sh "$repo/tools/update-sitemap-lastmod.sh" --staged
git add "$repo/sitemap.xml"
