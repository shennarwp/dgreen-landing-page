{
  "name": "dgreen-landing-page",
  // Static site: no build step, no runtime dependencies. This container
  // exists for a consistent shell (git, sh, awk for tools/*.sh), GitHub CLI,
  // and a one-command preview server. The smoke tests in tests/ run in a
  // browser against the preview URL.
  "image": "mcr.microsoft.com/devcontainers/base:bookworm",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {}
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Static preview (python3 -m http.server 8000)",
      "onAutoForward": "openPreview"
    }
  },
  // Host ~/.ssh (keys, config, known_hosts) is visible inside the container
  // read-only so git-over-SSH and the IDE's git integration work there.
  // Nothing is copied: same files, container-local reads. Requires the host
  // uid to match the container user (both 1000 on a default Debian install).
  "mounts": [
    "type=bind,source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,readonly"
  ],
  "shutdownAction": "none"
}
